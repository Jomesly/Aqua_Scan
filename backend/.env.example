# Copy to backend/.env and adjust. Every value is optional.

# --- Mode ------------------------------------------------------------------
# Demo mode seeds three example ponds on first start and simulates the probe.
# Everything it creates is labeled as demo data in the UI and exports.
TILAPIERS_DEMO=0
# Where the database and uploaded photos live (default: backend/data)
# TILAPIERS_DATA_DIR=data

# --- Temperature probe --------------------------------------------------------
# auto      find the DS18B20 probe on a USB serial port (never falls back to fake data)
# serial    same, and keep retrying every 30 s until it appears
# simulate  explicit simulator (demo)
# off       no local probe; readings arrive via POST /api/ingest/temperature
TILAPIERS_SENSOR=auto
# Force a port instead of auto-discovery, e.g. COM5 or /dev/ttyUSB0
# TILAPIERS_SERIAL_PORT=COM5
# Which pond the USB probe belongs to
TILAPIERS_SERIAL_POND=1
# Seconds between logged readings (the study sets the final interval in Chapter 3)
TILAPIERS_LOG_INTERVAL_S=10
# Shared secret for networked probes that upload buffered readings
# TILAPIERS_INGEST_TOKEN=change-me

# --- Notifications (channel still being decided: email or SMS) ---------------
# none | email | sms   (sms is recorded as "not sent" until a provider is chosen)
TILAPIERS_NOTIFY_CHANNEL=none
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=tilapiers@example.com
# SMTP_STARTTLS=1

# --- Fish detector -------------------------------------------------------------
# Path to trained YOLO26 segmentation weights (requires `pip install ultralytics`).
# Without it, a clearly labeled placeholder detector is used.
# TILAPIERS_YOLO_WEIGHTS=weights/yolo26-tilapia-seg.pt
