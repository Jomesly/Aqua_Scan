# Copy to backend/.env and adjust. Every value is optional.

# Demo mode seeds two example ponds and three accounts on first start.
# Everything it creates is labeled as demo data in the UI and exports.
TILAPIERS_DEMO=0
# Where the database and uploaded photos live (default: backend/data)
# TILAPIERS_DATA_DIR=data

# Disease screening model (Ultralytics detect weights, classes Healthy/Aeromonas/TiLV).
# Default: backend/models/yolov8s_best.pt. Swap to YOLO26s weights here when ready.
# TILAPIERS_YOLO_WEIGHTS=models/yolov8s_best.pt
# Optional fish segmentation weights (*-seg.pt). Without it the outline is found
# with classical image processing on the flat-view board (labeled "interim").
# TILAPIERS_SEG_WEIGHTS=models/yolo26s-seg-tilapia.pt

# Secret used to sign login sessions. Set a long random value for any real use.
# TILAPIERS_SECRET_KEY=change-me
